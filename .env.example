# Placeholders only. Copy to .env and replace locally. Do not commit .env.
# Empty REPLY_TO_ALLOWLIST rejects every reply_to. These strings are not live secrets.

CUE_BRIDGE_TOKEN=replace-with-bearer-token
CUE_BRIDGE_HMAC_KEY=replace-with-hmac-key
CUE_BRIDGE_TOKEN_SECONDARY=
CUE_BRIDGE_HMAC_KEY_SECONDARY=
REPLY_TO_ALLOWLIST=cue@example.com
REPLY_TO_DEFAULT=cue@example.com
# Both GROK_WEBHOOK_URL and GROK_WEBHOOK_KEY must be set to enable forwarding.
# Leave them empty so copying this file does not forward handoffs.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
GROK_WEBHOOK_KEY_HEADER=

# Docs and verification scripts only. The app does not read PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://hook.example.com
